# Untracked local tool state
.commandcode/
.macroscope/

# Agent state and worktrees
.agenttunnel/

# Node (desktop frontend uses its own lockfile under agenttunnel/desktop/frontend)
node_modules/

# The web UI copy step swaps placeholder assets for the real build; keep only
# the committed placeholder index.html tracked.
agenttunnel/internal/webui/dist/*
!agenttunnel/internal/webui/dist/index.html

# OS / editor
.DS_Store
*.log
.idea/
