{
  "name": "agenttunnel",
  "version": "0.1.0",
  "description": "Full-screen terminal UI wrapper for opencode AI coding agents with multi-agent orchestration.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "agenttunnel": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "opencode",
    "ai",
    "agent",
    "tui",
    "ink",
    "cli",
    "orchestration"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^7.0.5",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
